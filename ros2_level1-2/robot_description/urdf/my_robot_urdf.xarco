<?xml version="1.0"?>
<robot name="my_robot" xmlns:xarco="https://www.ros.org/wiki/xarco">

<xarco:<xacro:property name="basic_length" value="0.6" />>
<<xacro:property name="basic_width" value="0.4" />>
<<xacro:property name="wheel_radius" value="0.1" />>
<<xacro:property name="wheel_length" value="0.05" />>

<xarco:marco name="example_marco" params="a b c "> 
    <link name="dummy_link">
        <visual>
            <geometry>
                <box size="${a} ${b} ${c}"/>
            </geometry>
        </visual>
    </link>
</xarco:marco>
<xarco:<xacro:macro name="wheel_link" params="prefix">
    <link name="${prefix}_wheel_link">
    <visual>
        <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_length}}">
        </geometry>
    </visual>
    </link>
</xacro:macro>>
<xarco:wheel_link prefix="right">
<xarco:wheel_link prefix="left">

    <material name="blue">
        <color rgba="0 0 0.5 1" />
    </material>

    <material name = "grey">
        <color rgba="0.5 0.5 0.5 1"/>
    </material>
      
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${basic_length} 0.4 0.2"/>
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <material name="blue"/>
        </visual>
    </link> 

    <link name="base_footprint"/>

    <link name="rightwheel_link">
        <visual>                
            <geometry>                                        
                <cylinder radius="0.1" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="{pi/2.0} 0 0"/>
            pi=180=3.14
            pi/2=90=1.57
            <material name="grey"/>
        </visual>
    </link>        


    <link name="leftwheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05" />
            </geometry>
            <origin xyz="${-basic_length/4.0} 0.225 0" rpy="0 0 0"/>
            <material name="grey"/>        
        </visual>
    </link> 

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sopher radius="0.05"/>
            <geomopetry>
            <origin xyz="0.2 0 0" rpy="0 0 0">
            <material name= "grey" />

        </visual>
    </link>


    <joint name="base_rightwheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rightwheel_link"/>
        <origin xyz="${-basic_length/4.0} -0.225 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>
    
    <joint name="base_leftwheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="leftwheel_link"/>
        <origin xyz="${-basic_length/4.0} 0.225 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
    </joint>
    
    <joint name="base_caster_wheel_joint"  type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="${-basic_length/3.0}0 -0.05" rpy="0 0 0">
    
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="-0.15 -0.225 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>
    
    
    
    
    
</robot>
    

